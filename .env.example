# ============================================================
# ITBIS — Insider Threat Behavioral Intelligence System
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.
#
# Used by both `docker compose up` (reads this file automatically) and a
# locally-run backend (pydantic-settings loads backend/.env — copy this
# file there too, or symlink it). See docker-compose.yml for how the
# in-container backend overrides the *_HOST values below to reach the
# other containers directly; the host/port pairs here are for tools
# running on your machine (psql, mongosh, a non-Docker backend).
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_NAME=ITBIS
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# ─── docker-compose only ──────────────────────────────────────
# Host-side ports docker-compose.yml publishes the backend/frontend
# containers on. Irrelevant if you're not using docker-compose.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─── Security ────────────────────────────────────────────────
# Required — docker-compose.yml refuses to start the backend with the
# insecure pydantic default. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── PostgreSQL (Relational DB) ──────────────────────────────
# Use 127.0.0.1 rather than localhost on Windows: localhost can resolve
# to ::1 (IPv6), which the Postgres container does not listen on.
POSTGRES_HOST=127.0.0.1
# Host-side port from docker-compose.yml ("5434:5432"). Change both
# together if you remap it.
POSTGRES_PORT=5434
POSTGRES_DB=itbis_db
POSTGRES_USER=itbis_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ─── MongoDB (Document DB) ───────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=itbis_events
MONGO_USER=itbis_mongo_user
MONGO_PASSWORD=CHANGE_ME_strong_password
# authSource=admin is required: docker-compose creates this user via
# MONGO_INITDB_ROOT_USERNAME, which registers it in the `admin` database,
# not in MONGO_DB. Without it authentication fails.
MONGO_AUTH_SOURCE=admin

# ─── Redis (Cache / Sessions) ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_password
REDIS_DB=0

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/itbis.log

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── ML / Anomaly Detection ──────────────────────────────────
ISOLATION_FOREST_CONTAMINATION=0.05
ANOMALY_SCORE_THRESHOLD=0.7
BEHAVIORAL_BASELINE_DAYS=30

# ─── Notifications (not yet wired up — nothing reads these yet) ─────
# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=itbis@yourdomain.com
SMTP_TLS=true

# Slack
SLACK_WEBHOOK_URL=

# ─── First Superadmin (seed only) ────────────────────────────
FIRST_SUPERADMIN_EMAIL=admin@itbis.local
FIRST_SUPERADMIN_PASSWORD=CHANGE_ME_first_login_only

# --- Continuous detection pipeline ------------------------------------
# Every PIPELINE_INTERVAL_SECONDS the backend rebuilds behavioural features
# for the last PIPELINE_LOOKBACK_DAYS days (whole UTC days, including today),
# runs anomaly detection for users with activity, and creates alerts.
PIPELINE_ENABLED=true
PIPELINE_INTERVAL_SECONDS=300
PIPELINE_LOOKBACK_DAYS=2
PIPELINE_INITIAL_DELAY_SECONDS=30
