# ============================================================
# ITBIS — Insider Threat Behavioral Intelligence System
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_NAME=ITBIS
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# ─── Security ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── PostgreSQL (Relational DB) ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=itbis_db
POSTGRES_USER=itbis_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── MongoDB (Document DB) ───────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=itbis_events
MONGO_USER=itbis_mongo_user
MONGO_PASSWORD=CHANGE_ME_strong_password
MONGO_URL=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_DB}

# ─── Elasticsearch (Search) ──────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME_strong_password
ELASTICSEARCH_INDEX_PREFIX=itbis

# ─── Redis (Cache / Sessions) ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_password
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ─── Kafka (Message Queue) ───────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ACTIVITY_EVENTS=itbis.activity.events
KAFKA_TOPIC_ALERTS=itbis.alerts
KAFKA_CONSUMER_GROUP=itbis-consumer-group

# ─── MinIO (Object Storage) ──────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_SECURE=false
MINIO_BUCKET_EVIDENCE=itbis-evidence
MINIO_BUCKET_REPORTS=itbis-reports
MINIO_BUCKET_DATASETS=itbis-datasets

# ─── TimescaleDB (Time-Series Analytics) ─────────────────────
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433
TIMESCALE_DB=itbis_timeseries
TIMESCALE_USER=itbis_ts_user
TIMESCALE_PASSWORD=CHANGE_ME_strong_password
TIMESCALE_URL=postgresql+asyncpg://${TIMESCALE_USER}:${TIMESCALE_PASSWORD}@${TIMESCALE_HOST}:${TIMESCALE_PORT}/${TIMESCALE_DB}

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/itbis.log

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── ML / Anomaly Detection ──────────────────────────────────
ISOLATION_FOREST_CONTAMINATION=0.05
ANOMALY_SCORE_THRESHOLD=0.7
BEHAVIORAL_BASELINE_DAYS=30

# ─── Notifications ───────────────────────────────────────────
# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=itbis@yourdomain.com
SMTP_TLS=true

# Slack
SLACK_WEBHOOK_URL=

# ─── First Superadmin (seed only) ────────────────────────────
FIRST_SUPERADMIN_EMAIL=admin@itbis.local
FIRST_SUPERADMIN_PASSWORD=CHANGE_ME_first_login_only
